{
  "name": "gamehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run site:data:check && next build",
    "site:build": "npm run site:data:check && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism --maxWorkers 1",
    "typecheck": "tsc --noEmit",
    "site:data:export": "tsx scripts/export-site-data.ts",
    "site:data:check": "tsx scripts/check-site-data.ts",
    "cron:typecheck": "tsc --noEmit -p workers/cron-sync/tsconfig.json",
    "cron:readiness": "node --import tsx workers/cron-sync/check-deployment.ts",
    "cron:bundle": "wrangler deploy --dry-run --env= --containers-rollout=none --config workers/cron-sync/wrangler.jsonc --outdir /tmp/gamehub-cron-bundle --metafile /tmp/gamehub-cron-bundle/meta.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply gamehub --local",
    "db:check:local": "wrangler d1 migrations list gamehub --local",
    "db:verify:local": "tsx scripts/verify-d1.ts",
    "igdb:enrich": "tsx scripts/enrich-igdb-game.ts",
    "links:verify": "tsx scripts/verify-official-links.ts",
    "images:ingest": "tsx scripts/ingest-images.ts",
    "games:sync": "tsx scripts/sync-games.ts",
    "steam:import": "tsx scripts/import-steam-game.ts",
    "steam:search": "tsx scripts/search-steam-games.ts"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-select": "latest",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "latest",
    "next": "16.3.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "latest",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@eslint/eslintrc": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "drizzle-kit": "^0.31.10",
    "eslint": "latest",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "^4.127.1"
  }
}
